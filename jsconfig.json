{
  // Type-checking zero-build: VS Code legge questo file e controlla i .js
  // così come sono (JSDoc = annotazioni). Verifica da terminale:
  //   npx tsc -p jsconfig.json
  // Niente strictNullChecks: i pattern pool/null del codice richiederebbero
  // cast ovunque; noImplicitAny è la rete di sicurezza sui parametri.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "checkJs": true,
    "strict": false,
    "strictNullChecks": false,
    "noImplicitAny": true,
    "noEmit": true
  },
  "include": ["js"]
}
